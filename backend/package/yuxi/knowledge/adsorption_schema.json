{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper structure export",
  "type": "object",
  "properties": {
    "record_id": {"$ref": "#/$defs/record_identifier"},
    "extraction_metadata": {"$ref": "#/$defs/extraction_metadata"},
    "document": {"$ref": "#/$defs/paper_document"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "chemical_entities": {"type": "array", "items": {"$ref": "#/$defs/paper_entity"}},
    "material_identities": {"type": "array", "items": {"$ref": "#/$defs/paper_material"}},
    "sample_batches": {"type": "array", "items": {"$ref": "#/$defs/paper_batch"}},
    "sample_states": {"type": "array", "items": {"$ref": "#/$defs/paper_state"}},
    "synthesis_routes": {"type": "array", "items": {"$ref": "#/$defs/paper_route"}},
    "experiment_runs": {"type": "array", "items": {"$ref": "#/$defs/paper_run"}},
    "series_sets": {"type": "array", "items": {"$ref": "#/$defs/paper_series"}},
    "observations": {
      "type": "array",
      "items": {
        "anyOf": [
          {"$ref": "#/$defs/observations_quantitative_measurement"},
          {"$ref": "#/$defs/observations_reported_result"},
          {"$ref": "#/$defs/observations_result_group"}
        ]
      }
    },
    "mechanism_claims": {"type": "array", "items": {"$ref": "#/$defs/paper_claim"}},
    "missing_information": {"type": "array", "items": {"$ref": "#/$defs/missing_information"}},
    "validation_issues": {"type": "array", "items": {"$ref": "#/$defs/validation_issues"}},
    "quality_summary": {"$ref": "#/$defs/quality_summary"}
  },
  "required": [
    "record_id", "extraction_metadata", "document", "evidence", "chemical_entities", "material_identities",
    "sample_batches", "sample_states", "synthesis_routes", "experiment_runs", "series_sets", "observations",
    "mechanism_claims", "missing_information", "validation_issues", "quality_summary"
  ],
  "additionalProperties": false,
  "$defs": {
    "extraction_metadata": {
      "type": "object",
      "properties": {
        "created_on": {"type": "string", "format": "date"}
      },
      "required": ["created_on"],
      "additionalProperties": false
    },
    "paper_document": {
      "type": "object",
      "properties": {
        "document_id": {"$ref": "#/$defs/record_identifier"},
        "title": {"type": "string"},
        "authors": {"type": "array", "items": {"type": "string"}},
        "journal": {"type": "string"},
        "volume": {"type": ["integer", "string"]},
        "year": {"type": "integer"},
        "pages": {"type": "string"},
        "doi": {"type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$"},
        "received_date": {"type": "string", "minLength": 1},
        "revised_date": {"type": "string", "minLength": 1},
        "accepted_date": {"type": "string", "minLength": 1},
        "online_date": {"type": "string", "minLength": 1},
        "article_type": {"type": "string"},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "pdf_page_to_printed_page": {
          "type": "object",
          "propertyNames": {"pattern": "^[1-9][0-9]*$"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      },
      "required": ["document_id", "title", "pdf_page_to_printed_page"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {"$ref": "#/$defs/record_identifier"},
        "document_id": {"$ref": "#/$defs/record_identifier"},
        "provenance_scope": {"$ref": "#/$defs/provenance_scope"},
        "pdf_page": {"type": "integer", "minimum": 1},
        "printed_page": {"type": ["integer", "null"], "minimum": 1},
        "section": {"type": "string"},
        "location": {"type": "string"},
        "quote_raw": {"type": "string"},
        "extraction_origin": {"type": "string"}
      },
      "required": [
        "evidence_id", "document_id", "provenance_scope", "pdf_page", "printed_page",
        "section", "location", "quote_raw", "extraction_origin"
      ],
      "additionalProperties": false
    },
    "paper_entity": {
      "type": "object",
      "properties": {
        "entity_id": {"$ref": "#/$defs/record_identifier"},
        "reported_name": {"type": "string"},
        "canonical_name": {"type": "string"},
        "entity_class": {"type": "string"},
        "formula_ascii": {"type": "string"},
        "display_formula": {"type": "string"},
        "standard_or_grade": {"type": "string"},
        "supplier": {"type": "string"},
        "purity": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/paper_quantity"}]},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": ["entity_id", "reported_name", "evidence_ids"],
      "additionalProperties": false
    },
    "paper_material": {
      "type": "object",
      "properties": {
        "material_id": {"$ref": "#/$defs/record_identifier"},
        "reported_family_name": {"type": "string"},
        "abbreviation": {"type": "string"},
        "material_class": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": ["material_id", "reported_family_name", "evidence_ids"],
      "additionalProperties": false
    },
    "paper_batch": {
      "type": "object",
      "properties": {
        "sample_batch_id": {"$ref": "#/$defs/record_identifier"},
        "material_id": {"$ref": "#/$defs/record_identifier"},
        "reported_name": {"type": "string"},
        "series_id": {"$ref": "#/$defs/record_identifier"},
        "factor_assignments": {"$ref": "#/$defs/reported_parameters"},
        "batch_number": {"type": ["string", "number", "null"]},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": ["sample_batch_id", "material_id", "reported_name", "factor_assignments", "evidence_ids"],
      "additionalProperties": false
    },
    "paper_state": {
      "type": "object",
      "properties": {
        "sample_state_id": {"$ref": "#/$defs/record_identifier"},
        "sample_batch_id": {"$ref": "#/$defs/record_identifier"},
        "reported_name": {"type": "string"},
        "state": {"type": "string"},
        "physical_form": {"type": ["string", "null"]},
        "parent_state_ids": {"$ref": "#/$defs/record_identifiers"},
        "preparation_route_id": {"$ref": "#/$defs/record_identifier"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": ["sample_state_id", "sample_batch_id", "reported_name", "evidence_ids"],
      "additionalProperties": false
    },
    "paper_route": {
      "type": "object",
      "properties": {
        "route_id": {"$ref": "#/$defs/record_identifier"},
        "route_name": {"type": "string", "minLength": 1},
        "target_sample_state_ids": {"$ref": "#/$defs/record_identifiers"},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/paper_operation"}},
        "yield": {"$ref": "#/$defs/paper_condition_value"},
        "replicate_count": {"type": "integer", "minimum": 1},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": ["route_id", "route_name", "target_sample_state_ids", "operations", "evidence_ids"],
      "additionalProperties": false
    },
    "paper_operation": {
      "type": "object",
      "properties": {
        "operation_id": {"$ref": "#/$defs/record_identifier"},
        "sequence": {"type": "integer", "minimum": 1},
        "operation_type": {"type": "string", "minLength": 1},
        "operation_labels": {"type": "array", "items": {"type": "string"}},
        "equipment": {"type": ["string", "null"]},
        "input_sample_state_ids": {"$ref": "#/$defs/record_identifiers"},
        "output_sample_state_ids": {"$ref": "#/$defs/record_identifiers"},
        "input_intermediate_ids": {"$ref": "#/$defs/record_identifiers"},
        "output_intermediate_id": {"$ref": "#/$defs/record_identifier"},
        "simultaneous_processes": {"type": "boolean"},
        "reagent_uses": {"type": "array", "items": {"$ref": "#/$defs/paper_reagent_use"}},
        "conditions": {"$ref": "#/$defs/paper_operation_conditions"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": ["operation_id", "sequence", "operation_type", "conditions", "evidence_ids"],
      "additionalProperties": false
    },
    "paper_reagent_use": {
      "type": "object",
      "properties": {
        "reagent_use_id": {"$ref": "#/$defs/record_identifier"},
        "entity_id": {"$ref": "#/$defs/record_identifier"},
        "role": {"type": "string", "minLength": 1},
        "amount": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/paper_condition_value"}]},
        "concentration": {"$ref": "#/$defs/paper_condition_value"},
        "ratio": {"$ref": "#/$defs/paper_reagent_ratio"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": ["reagent_use_id", "entity_id"],
      "additionalProperties": false
    },
    "paper_reagent_ratio": {
      "type": "object",
      "properties": {
        "basis": {"type": "string", "minLength": 1},
        "numerator_entity_id": {"$ref": "#/$defs/record_identifier"},
        "denominator_entity_id": {"$ref": "#/$defs/record_identifier"},
        "value": {"$ref": "#/$defs/paper_quantity"},
        "per_sample_values": {"$ref": "#/$defs/paper_batch_parameters"}
      },
      "required": ["basis", "numerator_entity_id", "denominator_entity_id"],
      "additionalProperties": false
    },
    "paper_operation_conditions": {
      "type": "object",
      "properties": {
        "temperature_by_sample": {"$ref": "#/$defs/paper_batch_parameters"},
        "atmosphere_streams": {"type": "array", "items": {"$ref": "#/$defs/paper_atmosphere_stream"}},
        "temperature_qualifier": {"type": "string"},
        "pressure_qualifier": {"type": "string"},
        "cooling_protocol": {"type": "string"},
        "repeat_count": {"type": "integer", "minimum": 1},
        "repeat_qualifier": {"type": "string"},
        "endpoint": {"type": "string"},
        "endpoint_test_method": {"type": "string"}
      },
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/paper_condition_value"}
    },
    "paper_batch_parameters": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/record_identifier"},
      "additionalProperties": {"$ref": "#/$defs/reported_parameter"}
    },
    "paper_atmosphere_stream": {
      "type": "object",
      "properties": {
        "entity_id": {"$ref": "#/$defs/record_identifier"},
        "composition": {"$ref": "#/$defs/paper_condition_value"},
        "flow_rate": {"$ref": "#/$defs/paper_condition_value"}
      },
      "required": ["entity_id"],
      "additionalProperties": false
    },
    "paper_run": {
      "type": "object",
      "properties": {
        "run_id": {"$ref": "#/$defs/record_identifier"},
        "run_type": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "technique": {"type": "string", "minLength": 1},
        "data_origin": {"type": "string", "minLength": 1},
        "sample_state_ids": {"$ref": "#/$defs/record_identifiers"},
        "species_entity_ids": {"$ref": "#/$defs/record_identifiers"},
        "input_run_ids": {"$ref": "#/$defs/record_identifiers"},
        "instrument": {"anyOf": [{"type": ["string", "null"]}, {"$ref": "#/$defs/paper_instrument"}]},
        "probe": {"$ref": "#/$defs/paper_test_medium"},
        "sample_preparation": {"$ref": "#/$defs/paper_conditions"},
        "image_metadata": {"type": "array", "items": {"$ref": "#/$defs/paper_image_metadata"}},
        "preconditioning": {"$ref": "#/$defs/paper_conditions"},
        "analysis_methods": {"type": "array", "items": {"$ref": "#/$defs/paper_analysis_method"}},
        "excitation": {"$ref": "#/$defs/paper_conditions"},
        "temperature_program": {"$ref": "#/$defs/paper_conditions"},
        "atmosphere": {"$ref": "#/$defs/paper_atmosphere_stream"},
        "high_resolution_regions": {"type": "array", "items": {"type": "string"}},
        "component_mode": {"type": "string"},
        "adsorptives": {"type": "array", "items": {"$ref": "#/$defs/paper_test_medium"}},
        "temperatures": {"type": "array", "items": {"$ref": "#/$defs/paper_condition_value"}},
        "free_space_measurement": {"$ref": "#/$defs/paper_test_medium"},
        "ordered_species_pair": {"$ref": "#/$defs/paper_species_pair"},
        "selectivity_definition": {"type": "string"},
        "feed": {"type": "array", "items": {"$ref": "#/$defs/paper_test_medium"}},
        "temperature": {"$ref": "#/$defs/paper_condition_value"},
        "pressure": {"$ref": "#/$defs/paper_condition_value"},
        "pressure_domain": {"$ref": "#/$defs/paper_quantity"},
        "pressure_basis": {"type": "string"},
        "pressure_max_explicit_in_results": {"$ref": "#/$defs/paper_quantity"},
        "loading_unit_reported": {"type": "string"},
        "loading_definition": {"type": "string"},
        "mass_basis": {"type": "string"},
        "equilibrium_criterion": {"type": "string"},
        "input_temperatures": {"type": "array", "items": {"$ref": "#/$defs/paper_condition_value"}},
        "loading_domain": {"$ref": "#/$defs/paper_quantity"},
        "bed_type": {"type": "string"},
        "bed": {"$ref": "#/$defs/paper_conditions"},
        "flow": {"$ref": "#/$defs/paper_conditions"},
        "detector": {"type": "string"},
        "breakthrough_threshold": {"$ref": "#/$defs/paper_condition_value"},
        "subject_scope": {"$ref": "#/$defs/paper_subject_scope"},
        "software": {"$ref": "#/$defs/paper_software"},
        "level_of_theory": {"$ref": "#/$defs/paper_conditions"},
        "binding_energy_definition": {"type": "string"},
        "input_files": {"type": "array", "items": {"type": "string"}},
        "conditions": {"$ref": "#/$defs/paper_conditions"},
        "calculation_settings": {"$ref": "#/$defs/paper_conditions"},
        "model_name": {"type": "string"},
        "abbreviation": {"type": "string"},
        "equation_reported": {"type": "string"},
        "parameter_definitions": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "model_parameters": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/paper_conditions"}]},
        "model_parameters_missing_reason": {"type": "string"},
        "fit_quality_summary": {"$ref": "#/$defs/paper_conditions"},
        "series_set_ids": {"$ref": "#/$defs/record_identifiers"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": [
        "run_id", "run_type", "method", "sample_state_ids", "species_entity_ids",
        "conditions", "series_set_ids", "evidence_ids"
      ],
      "additionalProperties": false
    },
    "paper_test_medium": {
      "type": "object",
      "properties": {
        "entity_id": {"$ref": "#/$defs/record_identifier"},
        "temperature": {"$ref": "#/$defs/paper_condition_value"},
        "method_reported": {"type": "string"},
        "purity_value": {"type": "number"},
        "purity_unit": {"type": "string"},
        "reported_ratio_part": {"type": "number"},
        "mole_fraction": {"type": "number"},
        "mole_fraction_derived": {"type": "number"}
      },
      "required": ["entity_id"],
      "additionalProperties": false
    },
    "paper_image_metadata": {
      "type": "object",
      "properties": {
        "sample_state_id": {"$ref": "#/$defs/record_identifier"},
        "figure_panels": {"type": "array", "items": {"type": "string"}},
        "magnifications": {"type": "array", "items": {"$ref": "#/$defs/paper_condition_value"}},
        "scale_bars": {"type": "array", "items": {"$ref": "#/$defs/paper_condition_value"}},
        "accelerating_voltage": {"$ref": "#/$defs/paper_condition_value"},
        "working_distance": {"$ref": "#/$defs/paper_condition_value"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "additionalProperties": false
    },
    "paper_subject_scope": {
      "type": "object",
      "properties": {
        "kind": {"type": "string"},
        "material_id": {"$ref": "#/$defs/record_identifier"},
        "sample_specific_assignment": {"type": ["string", "boolean"]},
        "model_description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "paper_software": {
      "type": "object",
      "properties": {"name": {"type": "string"}, "version": {"type": ["string", "null"]}},
      "required": ["name"],
      "additionalProperties": false
    },
    "paper_instrument": {
      "type": "object",
      "properties": {
        "manufacturer": {"type": "string"},
        "manufacturer_reported": {"type": "string"},
        "manufacturer_normalized": {"type": "string"},
        "model": {"type": "string"},
        "normalization_status": {"type": "string"}
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "paper_analysis_method": {
      "type": "object",
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "derived_metric": {"type": "string"},
        "conditions": {"$ref": "#/$defs/paper_conditions"}
      },
      "required": ["method"],
      "additionalProperties": false
    },
    "paper_series": {
      "type": "object",
      "properties": {
        "series_set_id": {"$ref": "#/$defs/record_identifier"},
        "run_id": {"$ref": "#/$defs/record_identifier"},
        "series_kind": {"type": "string", "minLength": 1},
        "x": {"$ref": "#/$defs/paper_axis"},
        "y": {"$ref": "#/$defs/paper_axis"},
        "analysis_method": {"type": "string"},
        "temperature": {"$ref": "#/$defs/paper_condition_value"},
        "series_members": {"type": "array", "items": {"$ref": "#/$defs/paper_series_member"}},
        "source": {"$ref": "#/$defs/paper_series_source"},
        "x_axis_reported_in_figure": {"$ref": "#/$defs/paper_axis"},
        "x_axis_described_in_text_and_model": {"$ref": "#/$defs/paper_axis"},
        "axis_consistency_status": {"enum": ["consistent", "needs_review", "unknown"]},
        "observation_ids": {"$ref": "#/$defs/record_identifiers"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": [
        "series_set_id", "run_id", "series_kind", "x", "y", "series_members", "source",
        "observation_ids", "evidence_ids"
      ],
      "if": {"required": ["axis_consistency_status"], "properties": {"axis_consistency_status": {"const": "needs_review"}}},
      "then": {
        "required": ["x_axis_reported_in_figure", "x_axis_described_in_text_and_model"],
        "properties": {
          "x_axis_reported_in_figure": {"required": ["evidence_ids"], "properties": {"quantity": {"type": "string"}}},
          "x_axis_described_in_text_and_model": {"required": ["evidence_ids"], "properties": {"quantity": {"type": "string"}}}
        }
      },
      "additionalProperties": false
    },
    "paper_axis": {
      "type": "object",
      "properties": {
        "quantity": {"type": ["string", "null"], "minLength": 1},
        "unit": {"type": ["string", "null"]},
        "unit_raw": {"type": ["string", "null"]},
        "symbol": {"type": "string"},
        "expression": {"type": "string"},
        "loading_definition": {"type": "string"},
        "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "maximum": {"type": "number"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": ["quantity", "unit"],
      "additionalProperties": false
    },
    "paper_series_source": {
      "type": "object",
      "properties": {
        "figure": {"type": "string", "minLength": 1},
        "data_availability": {"enum": ["reported_points", "figure_only_not_digitized", "not_reported", "needs_review"]}
      },
      "required": ["data_availability"],
      "additionalProperties": false
    },
    "paper_series_member": {
      "type": "object",
      "properties": {
        "sample_state_id": {"anyOf": [{"$ref": "#/$defs/record_identifier"}, {"type": "null"}]},
        "entity_id": {"anyOf": [{"$ref": "#/$defs/record_identifier"}, {"type": "null"}]},
        "label": {"type": "string"},
        "branches": {"type": "array", "items": {"type": "string"}},
        "conditions": {"$ref": "#/$defs/paper_conditions"},
        "data_points": {
          "type": ["array", "null"],
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"},
              "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
            },
            "required": ["x", "y", "evidence_ids"],
            "additionalProperties": false
          }
        }
      },
      "required": ["sample_state_id", "entity_id", "data_points"],
      "additionalProperties": false
    },
    "observations_quantitative_measurement": {
      "type": "object",
      "properties": {
        "observation_id": {"$ref": "#/$defs/record_identifier"},
        "observation_type": {"const": "quantitative_measurement"},
        "run_id": {"$ref": "#/$defs/record_identifier"},
        "series_set_id": {"$ref": "#/$defs/record_identifier"},
        "sample_state_id": {"anyOf": [{"$ref": "#/$defs/record_identifier"}, {"type": "null"}]},
        "entity_id": {"anyOf": [{"$ref": "#/$defs/record_identifier"}, {"type": "null"}]},
        "ordered_species_pair": {"$ref": "#/$defs/paper_species_pair"},
        "metric_id": {"type": "string", "minLength": 1},
        "data_origin": {"type": "string", "minLength": 1},
        "conditions": {"$ref": "#/$defs/paper_conditions"},
        "condition_context": {"type": "string"},
        "value": {"$ref": "#/$defs/paper_quantity"},
        "sign_convention": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": [
        "observation_id", "observation_type", "run_id", "sample_state_id", "entity_id", "metric_id",
        "conditions", "value", "evidence_ids"
      ],
      "additionalProperties": false
    },
    "observations_reported_result": {
      "type": "object",
      "properties": {
        "observation_id": {"$ref": "#/$defs/record_identifier"},
        "observation_type": {"const": "reported_result"},
        "run_id": {"$ref": "#/$defs/record_identifier"},
        "series_set_id": {"$ref": "#/$defs/record_identifier"},
        "sample_state_ids": {"$ref": "#/$defs/record_identifiers"},
        "entity_id": {"$ref": "#/$defs/record_identifier"},
        "ordered_species_pair": {"$ref": "#/$defs/paper_species_pair"},
        "metric_id": {"type": "string", "minLength": 1},
        "data_origin": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "reported_order": {"type": "string"},
        "author_interpretation": {"type": "string"},
        "conditions": {"$ref": "#/$defs/paper_conditions"},
        "condition_context": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": [
        "observation_id", "observation_type", "run_id", "sample_state_ids",
        "metric_id", "result", "conditions", "evidence_ids"
      ],
      "additionalProperties": false
    },
    "observations_result_group": {
      "type": "object",
      "properties": {
        "observation_id": {"$ref": "#/$defs/record_identifier"},
        "observation_type": {"const": "result_group"},
        "run_id": {"$ref": "#/$defs/record_identifier"},
        "series_set_id": {"$ref": "#/$defs/record_identifier"},
        "sample_state_id": {"anyOf": [{"$ref": "#/$defs/record_identifier"}, {"type": "null"}]},
        "entity_id": {"anyOf": [{"$ref": "#/$defs/record_identifier"}, {"type": "null"}]},
        "ordered_species_pair": {"$ref": "#/$defs/paper_species_pair"},
        "data_origin": {"type": "string", "minLength": 1},
        "conditions": {"$ref": "#/$defs/paper_conditions"},
        "condition_context": {"type": "string"},
        "composition_basis": {"type": "string"},
        "results": {"type": "array", "items": {"$ref": "#/$defs/paper_observation_member"}},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": [
        "observation_id", "observation_type", "run_id", "sample_state_id", "entity_id",
        "conditions", "results", "evidence_ids"
      ],
      "additionalProperties": false
    },
    "paper_observation_member": {
      "type": "object",
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "entity_id": {"$ref": "#/$defs/record_identifier"},
        "value": {"$ref": "#/$defs/paper_quantity"},
        "result": {"type": "string", "minLength": 1},
        "sign_convention": {"type": "string"},
        "reported_order": {"type": "string"},
        "author_interpretation": {"type": "string"},
        "reported_assignment": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": ["metric_id", "evidence_ids"],
      "anyOf": [{"required": ["value"]}, {"required": ["result"]}],
      "additionalProperties": false
    },
    "paper_species_pair": {
      "type": "object",
      "properties": {
        "numerator_entity_id": {"$ref": "#/$defs/record_identifier"},
        "denominator_entity_id": {"$ref": "#/$defs/record_identifier"},
        "preferential_component_entity_id": {"$ref": "#/$defs/record_identifier"}
      },
      "required": ["numerator_entity_id", "denominator_entity_id"],
      "additionalProperties": false
    },
    "paper_claim": {
      "type": "object",
      "properties": {
        "claim_id": {"$ref": "#/$defs/record_identifier"},
        "claim_type": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "reported_order": {"type": "string"},
        "causal_strength": {"type": "string"},
        "provenance_scope": {"$ref": "#/$defs/provenance_scope"},
        "reported_background_values": {"$ref": "#/$defs/paper_conditions"},
        "normalization_note": {"type": "string"},
        "supported_by_observation_ids": {"$ref": "#/$defs/record_identifiers"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": ["claim_id", "claim_type", "claim", "supported_by_observation_ids", "evidence_ids"],
      "additionalProperties": false
    },
    "missing_information": {
      "type": "object",
      "properties": {
        "missing_id": {"$ref": "#/$defs/record_identifier"},
        "record_id": {"$ref": "#/$defs/record_identifier"},
        "fields": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "reason": {"type": "string"},
        "status": {"enum": ["not_reported", "unavailable", "needs_review"]},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": ["missing_id", "record_id", "fields", "reason", "status"],
      "if": {"properties": {"status": {"const": "not_reported"}}},
      "then": {"required": ["evidence_ids"]},
      "additionalProperties": false
    },
    "validation_issues": {
      "type": "object",
      "properties": {
        "issue_id": {"$ref": "#/$defs/record_identifier"},
        "severity": {"type": "string"},
        "issue_type": {"type": "string"},
        "record_ids": {"$ref": "#/$defs/record_identifiers", "minItems": 1},
        "message": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_identifiers"}
      },
      "required": ["issue_id", "severity", "issue_type", "record_ids", "message"],
      "additionalProperties": false
    },
    "quality_summary": {
      "type": "object",
      "properties": {
        "document_identity": {"type": "string"},
        "sample_registry": {"type": "string"},
        "synthesis_route": {"type": "string"},
        "overall_status": {"type": "string"},
        "experiment_count": {"type": "integer", "minimum": 0},
        "quantitative_observation_count": {"type": "integer", "minimum": 0},
        "experiments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "run_id": {"$ref": "#/$defs/record_identifier"},
              "observation_count": {"type": "integer", "minimum": 0},
              "status": {"enum": ["extracted_pending_review", "not_extracted"]}
            },
            "required": ["run_id", "observation_count", "status"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "document_identity", "sample_registry", "synthesis_route", "overall_status",
        "experiment_count", "quantitative_observation_count", "experiments"
      ],
      "additionalProperties": false
    },
    "record_identifier": {"type": "string", "minLength": 1, "maxLength": 128},
    "record_identifiers": {
      "type": "array",
      "items": {"$ref": "#/$defs/record_identifier"},
      "uniqueItems": true
    },
    "evidence_identifiers": {"$ref": "#/$defs/record_identifiers", "minItems": 1},
    "provenance_scope": {"enum": ["this_work", "cited_work", "mixed", "unknown"]},
    "reported_parameter": {
      "type": "object",
      "properties": {
        "raw_text": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string", "null"]},
        "unit": {"type": ["string", "null"]}
      },
      "required": ["raw_text", "value", "unit"],
      "additionalProperties": false
    },
    "reported_parameters": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/reported_parameter"}
    },
    "paper_conditions": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/paper_condition_value"}
    },
    "paper_condition_value": {
      "anyOf": [{"$ref": "#/$defs/reported_parameter"}, {"$ref": "#/$defs/paper_quantity"}]
    },
    "paper_quantity": {
      "anyOf": [{"$ref": "#/$defs/paper_scalar"}, {"$ref": "#/$defs/paper_range"}]
    },
    "paper_scalar": {
      "type": "object",
      "properties": {
        "kind": {"const": "scalar"},
        "raw_text": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit_raw": {"type": ["string", "null"]},
        "operator": {"type": "string"},
        "basis": {"type": "string"},
        "uncertainty": {"type": "number", "minimum": 0},
        "normalized_value": {"type": "number"},
        "unit_canonical": {"type": "string", "minLength": 1}
      },
      "required": ["kind", "raw_text", "value", "unit_raw"],
      "dependentRequired": {"normalized_value": ["unit_canonical"], "unit_canonical": ["normalized_value"]},
      "additionalProperties": false
    },
    "paper_range": {
      "type": "object",
      "properties": {
        "kind": {"const": "range"},
        "raw_text": {"type": "string", "minLength": 1},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "unit_raw": {"type": ["string", "null"]},
        "operator": {"type": "string"},
        "basis": {"type": "string"},
        "range_semantics": {"type": "string"},
        "normalized_value": {
          "type": "object",
          "properties": {
            "minimum": {"type": "number"},
            "maximum": {"type": "number"}
          },
          "required": ["minimum", "maximum"],
          "additionalProperties": false
        },
        "unit_canonical": {"type": "string", "minLength": 1}
      },
      "required": ["kind", "raw_text", "minimum", "maximum", "unit_raw"],
      "dependentRequired": {"normalized_value": ["unit_canonical"], "unit_canonical": ["normalized_value"]},
      "additionalProperties": false
    }
  }
}
